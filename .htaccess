# ============================================
# 결앤빛 - 서버 설정 (Apache 웹호스팅용)
# ▸ http:// 또는 www. 로 들어와도 https://gyeolnbit.co.kr 로 이동
#   (검색엔진이 주소를 하나로만 인식하게 해서 노출 점수가 나뉘지 않게 함)
# ▸ 업로드 후 "리디렉션이 너무 많습니다" 오류가 나면
#   호스팅 관리 화면에서 이미 https 자동 이동을 켜 둔 경우입니다.
#   그때는 아래 RewriteCond %{HTTPS} off [OR] 줄을 지우세요.
# ============================================

RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://gyeolnbit.co.kr%{REQUEST_URI} [L,R=301]

# 텍스트 파일 압축 (페이지 로딩 속도 향상)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# 브라우저 캐시 (사진·CSS·JS 재방문 시 빠르게)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
